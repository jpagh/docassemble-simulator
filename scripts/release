#!/usr/bin/env bash
# Bump the patch version, push the commit and tag, and publish the GitHub
# release with notes generated from the commits since the previous tag. The
# release event then triggers the PyPI publish workflow.
#
# Requires the GitHub CLI (`gh`) on PATH; it is deliberately not managed by
# mise (Homebrew's formula ships the zsh completion that mise's package lacks).
set -euo pipefail

usage() {
  echo "usage: scripts/release [--dry-run]" >&2
}

if [[ $# -gt 1 ]]; then
  usage
  exit 2
fi

dry_run=false
if [[ $# -eq 1 ]]; then
  if [[ $1 != "--dry-run" ]]; then
    usage
    exit 2
  fi
  dry_run=true
fi

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

if $dry_run; then
  bump-my-version bump patch --dry-run --verbose
  exit 0
fi

if ! command -v gh >/dev/null 2>&1; then
  echo "error: 'gh' (GitHub CLI) is required to publish the release;" >&2
  echo "       install it (e.g. brew install gh) and ensure it is on PATH." >&2
  exit 1
fi

# Keep the slow compatibility check as the first mutating-release phase. Run it
# through mise so the task provisions both supported runtime families before
# invoking scripts/test-runtime. Do not capture its output: a release operator
# needs to see provisioning and test progress, and an interrupted gate must not
# leave a child runtime process behind.
gate_pid=
cleanup_gate() {
  if [[ -n ${gate_pid:-} ]]; then
    # The gate is its own process group (see run_runtime_gate), so signal the
    # whole group: mise's descendants include the task shell, uv, pytest
    # workers, and the provisioned target interpreters. Fall back to the
    # process itself if the group is already gone.
    kill -TERM -- "-$gate_pid" 2>/dev/null || kill -TERM "$gate_pid" 2>/dev/null || true
    wait "$gate_pid" 2>/dev/null || true
    gate_pid=
  fi
}

on_interrupt() {
  local status=$1
  echo "release: runtime validation interrupted; no release changes were made" >&2
  cleanup_gate
  trap - INT TERM
  exit "$status"
}
trap 'on_interrupt 130' INT
trap 'on_interrupt 143' TERM
trap cleanup_gate EXIT

run_runtime_gate() {
  echo "release: running two-family runtime compatibility gate (mise run test:runtime)"
  # Monitor mode gives the background gate its own process group, so an
  # interrupt can terminate every descendant, not just the immediate mise.
  set -m
  mise run test:runtime &
  gate_pid=$!
  set +m

  local status
  set +e
  wait "$gate_pid"
  status=$?
  set -e
  gate_pid=
  if [[ $status -ne 0 ]]; then
    echo "error: runtime validation failed; release files and Git state were not changed" >&2
    return "$status"
  fi
}

run_runtime_gate

bump-my-version bump patch
git push --follow-tags

version=$(git describe --tags --abbrev=0)
previous=$(git describe --tags --abbrev=0 "${version}^")
slug=$(gh repo view --json nameWithOwner --jq .nameWithOwner)

notes=$(mktemp)
trap 'rm -f "$notes"' EXIT
{
  echo "## Changes"
  echo
  git log --no-merges --pretty='- %s' "${previous}..${version}" |
    grep -v '^- Bump version:' || true
  echo
  echo "**Full Changelog**: https://github.com/${slug}/compare/${previous}...${version}"
} > "$notes"

gh release create "$version" --verify-tag --title "$version" --notes-file "$notes"
