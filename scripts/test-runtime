#!/usr/bin/env bash
# Two-family real-runtime compatibility gate (issue #11).
#
# `mise run test:runtime` depends on `sync:da19` and `sync:da110`, so the lanes
# below are already provisioned by the time this script runs. The script
# validates those lanes, targets them explicitly, and runs the `real_runtime`
# contract selection (including screen-trace acceptance) with the external
# corpus excluded. A missing, broken, or wrong-family lane exits before pytest;
# an empty selection exits nonzero. tests/_runtime_gate.py additionally fails a
# green run when a family contributed no passing coverage.
#
# Runtime tests are safe to distribute because every test uses pytest's
# per-test temporary workspace. The default follows the machine but stays
# bounded at four workers, which measured well ahead of the old fixed default
# of two; set DASIMULATOR_RUNTIME_WORKERS=1 for serial debugging.
#
# usage: scripts/test-runtime [--modern PATH] [--legacy PATH] [pytest args...]
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

modern="$repo_root/.venv-da110/bin/python"
legacy="$repo_root/.venv-da19/bin/python"

detect_cpu_count() {
  local detected=""
  detected="$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)"
  if ! [[ "$detected" =~ ^[1-9][0-9]*$ ]]; then
    detected="$(sysctl -n hw.ncpu 2>/dev/null || true)"
  fi
  if [[ "$detected" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s' "$detected"
  fi
}

if [[ -n "${DASIMULATOR_RUNTIME_WORKERS:-}" ]]; then
  workers="$DASIMULATOR_RUNTIME_WORKERS"
else
  cpu_count="$(detect_cpu_count)"
  if [[ -n "$cpu_count" ]] && (( cpu_count < 4 )); then
    workers="$cpu_count"
  else
    workers=4
  fi
fi

if ! [[ "$workers" =~ ^[1-9][0-9]*$ ]] || (( workers > 8 )); then
  echo "error: DASIMULATOR_RUNTIME_WORKERS must be an integer from 1 to 8 (got '$workers')" >&2
  echo "       use 1 for serial execution; the default is min(4, CPU count)" >&2
  exit 2
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --modern)
      modern=$2
      shift 2
      ;;
    --legacy)
      legacy=$2
      shift 2
      ;;
    -h | --help)
      echo "usage: scripts/test-runtime [--modern PATH] [--legacy PATH] [pytest args...]" >&2
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

source "$repo_root/scripts/runtime-lane-preflight"

if ! command -v uv >/dev/null 2>&1; then
  echo "error: uv is not on PATH; run the gate through mise (mise run test:runtime)" >&2
  exit 2
fi

runtime_lane_preflight "modern" "$modern" "modern" "sync:da110" "runtime gate"
runtime_lane_preflight "legacy" "$legacy" "legacy" "sync:da19" "runtime gate"

export DASIMULATOR_REAL_PYTHON="$modern"
export DASIMULATOR_REAL_PYTHON_19="$legacy"
export DASIMULATOR_RUNTIME_GATE=1

cd "$repo_root"
echo "runtime gate: selecting 'real_runtime and not corpus' with $workers worker(s)"
pytest_args=(--durations=15 -q)
if (( workers > 1 )); then
  pytest_args+=(-n "$workers")
fi
pytest_args+=(-m 'real_runtime and not corpus' "$@")
set +e
uv run pytest "${pytest_args[@]}"
status=$?
set -e

if [[ $status -eq 5 ]]; then
  echo "error: the runtime gate selected no tests; check the real_runtime marker and any pytest arguments" >&2
fi
exit "$status"
